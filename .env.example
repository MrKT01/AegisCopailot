# Copia este archivo como .env y reemplaza los valores de ejemplo.
APP_ENV=development
SECRET_KEY=
FERNET_KEY=
# Solo durante la migración de una base existente; elimina esta variable al terminar.
OLD_FERNET_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_TO=tu-correo-receptor@example.com
SMTP_USER=tu-cuenta-emisora@gmail.com
SMTP_PASS=pega-aqui-tu-contrasena-de-aplicacion
OPENAI_API_KEY=
ALLOW_EXTERNAL_AI=false
# En despliegues con varios procesos, configura un almacenamiento compartido, por ejemplo Redis.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
